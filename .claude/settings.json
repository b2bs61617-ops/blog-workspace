{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NoProfile -File \".claude\\git-pull.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NoProfile -File \".claude\\koikeyz-monitor-check.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NoProfile -File \".claude\\farewell-check.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Agent",
      "TodoWrite",
      "WebFetch(domain:chomoand.com)",
      "WebFetch(domain:chomoand-0.com)",
      "WebFetch(domain:chomoand-1.com)"
    ],
    "ask": [
      "Bash(Remove-Item *)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(rmdir *)"
    ]
  }
}
