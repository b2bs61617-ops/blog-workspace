{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || bash \"$CLAUDE_PROJECT_DIR/tools/cloud/session_start.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || powershell -ExecutionPolicy Bypass -NoProfile -File \".claude\\git-pull.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || powershell -ExecutionPolicy Bypass -NoProfile -File \".claude\\koikeyz-monitor-check.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || powershell -ExecutionPolicy Bypass -NoProfile -File \".claude\\farewell-check.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { if command -v python3 >/dev/null 2>&1; then python3 tools/fix_youtube_embeds.py --hook; else python tools/fix_youtube_embeds.py --hook; fi; } 2>/dev/null; exit 0",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Edit(.claude)",
      "Write",
      "Write(.claude)",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Agent",
      "TodoWrite",
      "NotebookEdit",
      "WebFetch(domain:chomoand.com)",
      "WebFetch(domain:chomoand-0.com)",
      "WebFetch(domain:chomoand-1.com)",
      "PowerShell"
    ],
    "ask": [
      "Bash(Remove-Item *)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)"
    ]
  }
}
