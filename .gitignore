# 秘密情報(ローカルのみ・Gitに含めない)
.env
.env.local
tools/Xiy/xiy_config.json
tools/koikeyz-monitor/monitor_config.json
client_secret_*.json
token.json
.claude/settings.local.json
google-indexing-key.json
*-service-account*.json

# ブラウザ自動化プロファイル・キャッシュ(Cookie/ログイン情報を含む)
x_session/
x_capture/
tools/Xiy/*/x_session/

# KO1KEYZ監視ツールのローカル生成データ(PCごとの状態・収集結果)
tools/koikeyz-monitor/monitor_state.json
tools/koikeyz-monitor/monitor_reports/

# Xトレンド監視ツールのローカル生成データ(PCごとの状態・収集結果・ロック)
tools/x-trend-monitor/monitor_state.json
tools/x-trend-monitor/reports/
tools/x-trend-monitor/pipeline.lock

# YouTube タレント監視ツールのローカル生成データ(PCごとの状態・収集結果)
# frames/は動画から抽出した画像(著作権のある動画のフレームのためリポジトリに含めない。ローカルには残す方針)
tools/youtube-talent-monitor/monitor_state.json
tools/youtube-talent-monitor/reports/
tools/youtube-talent-monitor/frames/

# KO1KEYZ YouTube監視ツールのローカル生成データ(PCごとの状態・収集結果)
tools/koikeyz-youtube-monitor/monitor_state.json
tools/koikeyz-youtube-monitor/reports/
tools/koikeyz-youtube-monitor/frames/

# マラソン現在地トラッカーのローカル生成データ(PCごとの状態・記事バックアップ・ログ)
tools/marathon-tracker/state.json
tools/marathon-tracker/backups/
tools/marathon-tracker/logs/
tools/marathon-tracker/run.log
tools/marathon-tracker/tracker.lock
tools/marathon-tracker/mapshot/*
!tools/marathon-tracker/mapshot/README.md

# 記事本文用に公式YouTube動画から手動で切り出したフレーム画像(著作権のある動画のフレームのためリポジトリに含めない。ローカル・WordPressメディアライブラリには残す方針)
images/*_video_frame.jpg
images/*_video_frame.png

# ショート動画パイプライン(tools/shorts/)のダウンロード素材・生成物(著作権のある動画のためリポジトリに含めない。ローカルのみ残す方針)
tools/shorts/downloads/
tools/shorts/output/

# Pythonキャッシュ
__pycache__/
*.pyc

