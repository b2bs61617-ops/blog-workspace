# このファイルをコピーして .env という名前で保存し、実際の値を入力する。
# .env は Git に含まれない(.gitignore で除外済み)。
# 実際のアプリパスワードの値は、パスワードマネージャーなどGit以外の安全な経路で共有すること。

# トレンドブログ (chomoand.com)
WP_TREND_URL=https://chomoand.com
WP_TREND_USERNAME=
WP_TREND_APP_PASSWORD=

# ジャニオタブログ (chomoand-0.com)
WP_AUDITION_URL=https://chomoand-0.com
WP_AUDITION_USERNAME=
WP_AUDITION_APP_PASSWORD=

# コイキーズブログ (chomoand-1.com)
WP_KOIKEYS_URL=https://chomoand-1.com
WP_KOIKEYS_USERNAME=
WP_KOIKEYS_APP_PASSWORD=

# LINE通知(記事更新時にLINEへ通知する。tools/line_notify.py参照)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# YouTube Data API(急上昇動画から旬な人物を発見する。tools/youtube_trending.py参照)
# 取得手順はdocs/youtube-api-setup.md参照
YOUTUBE_API_KEY=

# Gemini API(YouTubeタレント監視の画像解析=服装・アクセサリー・ロケ地の特定に使用。
# tools/youtube-talent-monitor/visual_analysis.py参照。https://aistudio.google.com/apikey で発行)
GEMINI_API_KEY=

# Google Indexing API(記事公開時にURLの即時インデックス登録をリクエストする。tools/google_indexing.py参照)
# セットアップ手順はdocs/google-indexing-setup.md参照。値はサービスアカウントJSON鍵ファイルの絶対パス
GOOGLE_INDEXING_CREDENTIALS_PATH=

# Naver IndexNow(コイキーズブログの韓国語記事公開時にNaverへ即時インデックス登録をリクエストする。tools/naver_indexnow.py参照)
# セットアップ手順はdocs/naver-search-advisor-setup.md参照。値は生成した16進数キー文字列
NAVER_INDEXNOW_KEY=

# X(旧Twitter)自動投稿(記事公開時にXへ自動投稿する。tools/x_auto_post.py参照。2026-08-09〜Zapierから移行)
# セットアップ手順はdocs/x-auto-post-setup.md参照。サイトごとに別のXアカウント・別のDeveloper Appを想定
# トレンドブログ (chomoand.com)
X_TREND_API_KEY=
X_TREND_API_SECRET=
X_TREND_ACCESS_TOKEN=
X_TREND_ACCESS_TOKEN_SECRET=
# ジャニオタブログ (chomoand-0.com)
X_AUDITION_API_KEY=
X_AUDITION_API_SECRET=
X_AUDITION_ACCESS_TOKEN=
X_AUDITION_ACCESS_TOKEN_SECRET=
# コイキーズブログ (chomoand-1.com)
X_KOIKEYS_API_KEY=
X_KOIKEYS_API_SECRET=
X_KOIKEYS_ACCESS_TOKEN=
X_KOIKEYS_ACCESS_TOKEN_SECRET=

# 楽天ウェブサービス(商品検索API)+楽天アフィリエイト(コイキーズ記事の商品リンク自動生成。tools/affiliate_linker.py参照)
# アプリID・アクセスキー: https://webservice.rakuten.co.jp/ で発行(2026年5月のAPI仕様移行でアクセスキーも必須に) / アフィリエイトID: https://affiliate.rakuten.co.jp/ で発行
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイト(コイキーズ記事の商品リンク自動生成。検索結果ページへのタグ付きリンクのみでPA-APIは未使用。tools/affiliate_linker.py参照)
AMAZON_ASSOCIATE_TAG=
