# このファイルをコピーして .env という名前で保存し、実際の値を入力する。
# .env は Git に含まれない(.gitignore で除外済み)。
# 実際のアプリパスワードの値は、パスワードマネージャーなどGit以外の安全な経路で共有すること。

# トレンドブログ (chomoand.com)
WP_TREND_URL=https://chomoand.com
WP_TREND_USERNAME=
WP_TREND_APP_PASSWORD=

# ジャニオタブログ (chomoand-0.com)
WP_AUDITION_URL=https://chomoand-0.com
WP_AUDITION_USERNAME=
WP_AUDITION_APP_PASSWORD=

# コイキーズブログ (chomoand-1.com)
WP_KOIKEYS_URL=https://chomoand-1.com
WP_KOIKEYS_USERNAME=
WP_KOIKEYS_APP_PASSWORD=

# LINE通知(記事更新時にLINEへ通知する。tools/line_notify.py参照)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# YouTube Data API(急上昇動画から旬な人物を発見する。tools/youtube_trending.py参照)
# 取得手順はdocs/youtube-api-setup.md参照
YOUTUBE_API_KEY=

# Google Indexing API(記事公開時にURLの即時インデックス登録をリクエストする。tools/google_indexing.py参照)
# セットアップ手順はdocs/google-indexing-setup.md参照。値はサービスアカウントJSON鍵ファイルの絶対パス
GOOGLE_INDEXING_CREDENTIALS_PATH=

# 楽天ウェブサービス(商品検索API)+楽天アフィリエイト(コイキーズ記事の商品リンク自動生成。tools/affiliate_linker.py参照)
# アプリID: https://webservice.rakuten.co.jp/ で発行 / アフィリエイトID: https://affiliate.rakuten.co.jp/ で発行
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイト(コイキーズ記事の商品リンク自動生成。検索結果ページへのタグ付きリンクのみでPA-APIは未使用。tools/affiliate_linker.py参照)
AMAZON_ASSOCIATE_TAG=
